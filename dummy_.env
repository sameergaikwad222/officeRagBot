# =========================
# CONNECTIONS
# =========================
OLLAMA_URL=http://ollama:11434
QDRANT_URL=http://qdrant:6333

# Change collection whenever you change embedding models.
COLLECTION=documents


# =========================
# API KEYS
# Required only for the selected cloud provider.
# =========================
OPENAI_API_KEY=
GOOGLE_API_KEY=


# =========================
# CHAT MODEL — choose ONE
# =========================

# Ollama — local
CHAT_PROVIDER=ollama
CHAT_MODEL=llama3.2:3b

# OpenAI
# CHAT_PROVIDER=openai
# CHAT_MODEL=gpt-5-nano

# Gemini — replace with an available model ID
# CHAT_PROVIDER=google_genai
# CHAT_MODEL=your-gemini-chat-model-id


# =========================
# EMBEDDING MODEL — choose ONE
# =========================

# Ollama — local
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text

# OpenAI
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small

# Gemini — replace with an available embedding model ID
# EMBEDDING_PROVIDER=google_genai
# EMBEDDING_MODEL=your-gemini-embedding-model-id